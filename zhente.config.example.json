{
  "provider": {
    "type": "openai",
    "baseURL": "https://api.openai.com/v1",
    "apiKey": "${OPENAI_API_KEY}",
    "model": "gpt-4o",
    "models": [
      {
        "modelId": "gpt-4o",
        "name": "GPT-4o",
        "description": "默认模型"
        // 可按模型覆盖 maxTokens / streamIdleTimeoutMs / streamTotalTimeoutMs /
        // streamRetries / streamRetryBaseDelayMs；未设置时用 provider 下的同名全局值
        // "maxTokens": 32768
      }
    ],
    "temperature": 0,
    // 不设置时不发送 max_tokens，交给后端自己的默认值（DeepSeek 思考模式默认 64K）
    // "maxTokens": 32768,
    "requestTimeoutMs": 120000,
    "streamIdleTimeoutMs": 60000,
    "streamTotalTimeoutMs": 120000,
    "streamRetries": 2,
    "streamRetryBaseDelayMs": 500,
    "streamIncludeUsage": true,
    // 默认 "all"：把捕获的 reasoning_content 回传给后端（DeepSeek 思考模式要求）；
    // 端点不认识该字段且会报错时改 "none"
    // "passBackReasoning": "all",
    "extraHeaders": {}
  },
  "agent": {
    "maxIterations": 40,
    "historyWarningMessages": 400,
    "toolTimeoutMs": 300000,
    "permissionMode": "confirm",
    "systemPrompt": null
  },
  "mcp": {
    "enabled": true,
    "connectTimeoutMs": 15000
  },
  "skills": {
    "enabled": true,
    "dirs": []
  }
}
