{
  "provider": {
    "type": "openai",
    "baseURL": "https://api.openai.com/v1",
    "apiKey": "${OPENAI_API_KEY}",
    "model": "gpt-4o",
    "models": [
      {
        "modelId": "gpt-4o",
        "name": "GPT-4o",
        "description": "默认模型"
        // 可按模型覆盖 maxTokens / firstChunkTimeoutMs / streamIdleTimeoutMs /
        // streamTotalTimeoutMs / streamRetries / streamRetryBaseDelayMs；
        // 未设置时用 provider 下的同名全局值
        // "maxTokens": 32768
      }
    ],
    "temperature": 0,
    // 不设置时不发送 max_tokens，交给后端自己的默认值（DeepSeek 思考模式默认 64K）
    // "maxTokens": 32768,
    "requestTimeoutMs": 120000,
    // 首个流式 chunk 前的等待上限（连接建立 + 服务端排队）；默认 10 分钟，
    // 对齐 DeepSeek 高负载时"10 分钟未开始推理即断连"的窗口
    "firstChunkTimeoutMs": 600000,
    "streamIdleTimeoutMs": 60000,
    "streamTotalTimeoutMs": 120000,
    "streamRetries": 2,
    "streamRetryBaseDelayMs": 500,
    "streamIncludeUsage": true,
    // 默认 "all"：把捕获的 reasoning_content 回传给后端（DeepSeek 思考模式要求）；
    // 端点不认识该字段且会报错时改 "none"
    // "passBackReasoning": "all",
    "extraHeaders": {}
  },
  "agent": {
    "maxIterations": 120,
    "historyWarningMessages": 400,
    "toolTimeoutMs": 300000,
    "permissionMode": "confirm",
    "systemPrompt": null
  },
  "mcp": {
    "enabled": true,
    "connectTimeoutMs": 15000
  },
  "skills": {
    "enabled": true,
    "dirs": []
  },
  "hooks": {
    // 生命周期钩子（默认关闭）：在固定点位跑外部命令，stdin 收 JSON 信封、
    // stdout 出决策 JSON，`exit 2` 等价 deny。详见 README 的「Hook（生命周期钩子）」。
    // 注意：deny 与 ask 在 permissionMode=auto（Full Access）下同样生效。
    // 想要"在所有项目里都生效"的 hook，就把 hooks 写进 ~/.config/zhente/config.json
    // （全局 base，见 README 的「配置分层」）；本文件的 hooks.events 是**追加**在它后面的。
    "enabled": false,
    "timeoutMs": 60000,
    // 超时 / 崩溃 / 输出不可解析时："allow"（默认放行）| "deny"（fail-closed）
    "onError": "allow",
    // null = 平台默认（shell: true）；也可指定 "/bin/bash"
    "shell": null,
    // 项目级 hooks（.zhente/hooks.json）：默认关闭 —— 该文件随仓库分发，
    // 开启等于“打开仓库就执行它声明的任意命令”（供应链风险）。
    // 开启后：相对路径以项目根为基准；onError / timeoutMs 只能更严不能放宽。
    "projectFile": {
      "enabled": false,
      "path": ".zhente/hooks.json"
    },
    "events": {
      // 配置级 hook 一律用绝对路径或 ${HOME}/…：相对路径的解析基准是**本配置文件
      // 所在目录**（不是 session cwd），写错位置会在加载期直接报错（fail fast）。
      "session_start": [
        // matcher 匹配 source：startup（session/new）| resume（session/load），与 codex 的
        // SessionStart 一致；没有可匹配字段的事件上写 matcher 会被忽略（并 warn 一次）。
        // { "name": "git-context", "command": "bash ${HOME}/.config/zhente/hooks/git-context.sh", "matcher": "startup|resume" },
        // 后台预热（命令自己 & 掉即可立刻返回；同步 hook + 后台任务）：
        // { "name": "warm-index", "command": "sh -c 'some-index --silent >/dev/null 2>&1 &'", "matcher": "startup|resume", "timeoutMs": 2000 }
      ],
      "user_prompt_submit": [
        // { "name": "secret-scan", "command": "bash ${HOME}/.config/zhente/hooks/secret-scan.sh", "timeoutMs": 5000, "onError": "deny" }
      ],
      "pre_tool_use": [
        // { "name": "guard-writes", "matcher": "^(write_file|edit_file)$", "command": "bash ${HOME}/.config/zhente/hooks/guard-writes.sh" },
        // { "name": "guard-bash", "matcher": "^bash$", "command": "bash ${HOME}/.config/zhente/hooks/guard-bash.sh", "onError": "deny" },
        // MCP 工具的注册名带前缀：{ "name": "guard-mcp", "matcher": "^mcp__router__execute_terminal_command$", "command": "bash ${HOME}/.config/zhente/hooks/guard-mcp.sh" }
      ],
      "post_tool_use": [
        // { "name": "ts-check", "matcher": "^edit_file$", "command": "bash ${HOME}/.config/zhente/hooks/ts-check.sh", "timeoutMs": 120000 }
      ],
      "turn_end": [
        // { "name": "audit", "command": "bash ${HOME}/.config/zhente/hooks/audit.sh" }
      ],
      "session_end": [
        // { "name": "cleanup", "command": "bash ${HOME}/.config/zhente/hooks/cleanup.sh" }
      ]
    }
  }
}
