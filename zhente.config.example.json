{
  "provider": {
    "type": "openai",
    "baseURL": "https://api.openai.com/v1",
    "apiKey": "${OPENAI_API_KEY}",
    "model": "gpt-4o",
    "models": [
      {
        "modelId": "gpt-4o",
        "name": "GPT-4o",
        "description": "默认模型"
        // 可按模型覆盖 maxTokens / streamIdleTimeoutMs / streamTotalTimeoutMs /
        // streamRetries / streamRetryBaseDelayMs；未设置时用 provider 下的同名全局值
        // "maxTokens": 32768
      }
    ],
    "temperature": 0,
    "maxTokens": 8192,
    "requestTimeoutMs": 120000,
    "streamIdleTimeoutMs": 60000,
    "streamTotalTimeoutMs": 120000,
    "streamRetries": 2,
    "streamRetryBaseDelayMs": 500,
    "streamIncludeUsage": false,
    "extraHeaders": {}
  },
  "agent": {
    "maxIterations": 40,
    "historyWarningMessages": 400,
    "toolTimeoutMs": 300000,
    "permissionMode": "confirm",
    "systemPrompt": null
  },
  "mcp": {
    "enabled": true,
    "connectTimeoutMs": 15000
  },
  "skills": {
    "enabled": true,
    "dirs": []
  }
}
