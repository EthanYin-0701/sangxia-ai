{
  "provider": {
    "type": "openai",
    "baseURL": "https://api.openai.com/v1",
    "apiKey": "${OPENAI_API_KEY}",
    "model": "gpt-4o",
    "models": [
      {
        "modelId": "gpt-4o",
        "name": "GPT-4o",
        "description": "默认模型"
      }
    ],
    "temperature": 0,
    "maxTokens": 8192,
    "requestTimeoutMs": 120000,
    "extraHeaders": {}
  },
  "agent": {
    "maxIterations": 40,
    "permissionMode": "confirm",
    "systemPrompt": null
  },
  "mcp": {
    "enabled": true,
    "connectTimeoutMs": 15000
  },
  "skills": {
    "enabled": true,
    "dirs": []
  }
}
