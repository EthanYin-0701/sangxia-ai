@startuml prompt-turn
title ZhenTe ACP Agent —— newSession 装配 + 一次 prompt 的处理时序\n（★ 高亮 Harness；并含 MCP 工具与 技能(Skills)）

skinparam responseMessageBelowArrow true
skinparam sequenceMessageAlign center
autonumber

actor "用户" as User

box "ACP 客户端" #F5F5F5
  participant "编辑器 / 客户端\n(JetBrains ACP Client)" as Client
end box

box "ACP Agent 接口 · src/agent.ts" #E8F0FE
  participant "ZhenTeAgent" as Agent
  participant "Session\n(历史 / 工具集 / MCP连接 / 技能)" as Session
end box

box "★ Harness · src/harness/" #FFF2CC
  participant "runTurn 主循环\n(loop.ts)" as Loop
  participant "权限门\n(permissions.ts)" as Perm
end box

box "技能 · src/skills" #EDE7F6
  participant "skills/index.ts\n(discover / use_skill)" as Skills
end box

box "MCP 客户端 · src/mcp" #E0F7FA
  participant "connectMcpServer\n(client.ts)" as Mcp
end box

participant "外部 MCP Server\n(stdio/http/sse)" as McpSrv

box "LLM Provider · src/llm" #E6F4EA
  participant "OpenAIProvider\n(openai.ts)" as LLM
end box

participant "OpenRouter / OpenAI\n/v1/chat/completions" as API

box "内置工具 · src/tools" #FCE8E6
  participant "具体工具\n(read_file / bash / …)" as Tool
end box

note over Loop, Perm
  ★ Harness = 编排「一次 prompt turn」的中间层，把 <b>ACP 协议</b> 与
  <b>可插拔的 LLM / 工具</b> 解耦。它负责：迭代循环、把模型流事件转成
  sessionUpdate、维护历史、工具调度(ToolRegistry)、权限门、输出截断、
  stopReason 判定。黄色泳道(Loop / Perm)发出的箭头都是 Harness。
  MCP 工具与 use_skill 都被包成统一的 Tool，走同一套调度/权限/回喂路径。
end note

== 会话建立：newSession（每会话一次，装配本会话工具集） ==
Client -> Agent   : session/new(cwd, mcpServers[])
Agent  -> Session : new Session(...)

group 发现技能（config.skills.enabled）
  Agent  -> Skills  : discoverSkills(cwd, dirs)
  Skills -> Skills  : 扫描 <cwd>/skills 与 ~/.config/zhente/skills\n解析 SKILL.md frontmatter(name/description)
  Skills --> Agent  : Skill[]{ name, description, path }
  Agent  -> Session : 存 session.skills；system prompt 追加「技能清单」
end

group 连接 MCP（config.mcp.enabled，逐个 try/catch 隔离失败）
  loop 每个 mcpServer
    Agent  -> Mcp    : connectMcpServer(server, timeoutMs)
    Mcp    -> McpSrv : 建立 transport(stdio/http/sse) + initialize
    Mcp    -> McpSrv : tools/list
    McpSrv --> Mcp   : tools[]
    Mcp    --> Agent : 包成 Tool[]（mcp__<server>__<tool>，needsPermission=true）
    Agent  -> Session: session.mcpConnections.push(conn)
  end
end

Agent -> Session : session.tools = new ToolRegistry(内置 + use_skill? + MCP工具)
Agent --> Client : { sessionId }
note over Agent, Session : 本会话工具集 = 内置(tools/*) + use_skill(若发现技能) + 各 MCP 工具

== 接收 prompt（agent.ts，非 harness） ==
User   -> Client : 输入 prompt
Client -> Agent  : session/prompt(sessionId, prompt[])
Agent  -> Session : 按 sessionId 查会话（找不到报 invalidParams）
Agent  -> Agent  : promptToText 展平内容块
Agent  -> Session : messages.push(user 消息)
Agent  -> Agent  : new AbortController，session.abort = abort
Agent  -> Loop   : runTurn({conn, session, provider, tools=session.tools, config, signal})
note right of Agent : 交接点：agent.ts 把一次 turn 委托给 Harness\n（tools 即本会话装配好的 session.tools）

== ★Harness 主循环 ==
loop 最多 config.maxIterations (=40) 轮  【Harness 循环控制】
  break signal.aborted
    Loop --> Agent : return "cancelled"  【Harness 判定】
  end

  == 1) 请求模型（流式） ==
  Loop -> LLM : streamChat({messages, tools.schemas(), signal})
  note right of Loop : tools.schemas() = 内置 + MCP(mcp__*) + use_skill\n统一由 ToolRegistry 通告 → Harness
  LLM  -> API : POST /chat/completions（stream=true, tool_choice=auto）

  group 流式返回 (SSE)：★Harness 边收边转发
    API --> LLM  : text-delta / reasoning-delta / tool_calls 分片 / done
    LLM --> Loop : 聚合后的流事件
    Loop -> Client : sessionUpdate(agent_message_chunk / agent_thought_chunk)
  end

  break 流式请求异常（如 404 / 网络错误）
    Loop -> Loop   : logger.error("LLM 流式请求失败")
    Loop -> Client : sessionUpdate(agent_message_chunk "[错误]…")
    Loop --> Agent : return "refusal"  【Harness 判定：异常→refusal】
  end

  Loop -> Session : messages.push(assistant：正文 + tool_calls)  【Harness 维护历史】

  == 2) 是否需要工具？【Harness 判定】 ==
  alt 没有 tool_calls
    Loop --> Agent : return "end_turn"
  else 有 tool_calls —— ★Harness 逐个调度执行
    loop 遍历每个 tool call
      Loop -> Loop   : JSON.parse(arguments)，tools.get(name)  【Harness 调度】
      Loop -> Client : sessionUpdate(tool_call, in_progress)

      opt tool.needsPermission 且 !config.autoApprove  【Harness 权限门】
        note over Loop, Perm : 写/改类内置工具与 <b>全部 MCP 工具</b> 命中此门；\nuse_skill 与只读工具 needsPermission=false，跳过
        Loop -> Perm    : ensurePermission(tool, …)
        Perm -> Session : 查已记住的权限决定
        alt 无记忆决定
          Perm   -> Client : session/request_permission（允许/拒绝，可"总是"）
          Client -> User   : 弹窗询问
          User  --> Client : 选择
          Client --> Perm  : outcome(optionId)
          Perm -> Session  : 记住 allow_always / reject_always
        end
        Perm --> Loop : decision(allow / reject)
        break decision == reject
          Loop -> Client  : tool_call_update(failed, 用户拒绝)
          Loop -> Session : push tool 结果(Error: 用户拒绝)
        end
      end

      == 3) 执行工具：get(name).run()（Harness 统一调度；按类型展开 run 内部）==
      alt 内置工具（tools/*）
        Loop -> Tool : run(args, ctx)
        opt 文件类工具 且 客户端支持 fs
          Tool  -> Client : readTextFile / writeTextFile
          Client --> Tool : 内容 / 完成
        end
        Tool --> Loop : ToolResult{ output, isError, raw }
      else use_skill（skills/index.ts）
        Loop   -> Skills : run({name}, ctx)
        Skills -> Skills : 从 session.skills 命中 → 读 SKILL.md → 去 frontmatter
        Skills --> Loop  : ToolResult{ 技能正文 }
        note right of Skills : 正文回喂进上下文，模型据此执行\n（技能的「渐进式披露」）
      else MCP 工具 mcp__*（mcp/client.ts）
        Loop   -> Mcp    : run(args, ctx)
        Mcp    -> McpSrv : tools/call(name, args)（带 signal）
        McpSrv --> Mcp   : CallToolResult(content[])
        Mcp    --> Loop  : ToolResult{ content 文本拼接, isError }
      end

      Loop -> Loop    : truncate(output) 截断至 100k  【Harness】
      Loop -> Client  : sessionUpdate(tool_call_update, completed/failed)
      Loop -> Session : push tool 结果  【Harness 维护历史】
    end
    note over Loop, Session : ★Harness：工具结果已入历史，\n回到循环顶部让模型继续下一步
  end
end

break 达到 maxIterations 仍未结束
  Loop -> Loop   : logger.warn(...)
  Loop --> Agent : return "max_turn_requests"  【Harness 判定】
end

== 返回结果（agent.ts，非 harness） ==
Agent -> Agent   : logger.info("prompt id → stopReason")
Agent -> Session : session.abort = null（finally）
Agent --> Client : PromptResponse{ stopReason }
Client -> User   : 展示最终结果

note over Agent, McpSrv
  会话结束/进程退出：agent.shutdown() → 逐个 session.dispose()
  关闭全部 MCP 连接（ACP 0.4.5 无「会话结束」事件，故统一在退出时回收）。
end note

@enduml
