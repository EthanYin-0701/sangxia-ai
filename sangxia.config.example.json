// 带注释的参考示例（JSONC），不要直接复制为运行配置；加载器只接受严格 JSON。
// 推荐: sangxia setup（交互输入 API key 不回显）。
// Headless: sangxia setup --non-interactive --api-key-env SANGXIA_API_KEY
//           --base-url https://api.openai.com/v1 --model gpt-4o
// 先在环境中设置 SANGXIA_API_KEY；保存的是 ${SANGXIA_API_KEY} 引用，启动时也需注入。
// 无任何配置文件时，只设置 SANGXIA_API_KEY 即可启动；可选 SANGXIA_BASE_URL / SANGXIA_MODEL。
// 上述 provider 环境变量不会覆盖已有配置文件；文件内可显式使用 ${VAR} 插值。
// 权限模式另支持 SANGXIA_PERMISSION_MODE 覆盖文件配置。
// setup 写入 ~/.config/sangxia/config.json，保留已有 hooks / agent / mcp 等段。
// 项目配置只填写需要覆盖的字段；全局配置始终作为 base，项目配置作为 overlay。
// 对象逐字段合并，普通数组整体替换；只有 hooks.events.* 数组追加。
{
  "provider": {
    "type": "openai",
    "baseURL": "https://api.openai.com/v1",
    "apiKey": "${SANGXIA_API_KEY}",
    "model": "gpt-4o",
    "models": [
      {
        "modelId": "gpt-4o",
        "name": "GPT-4o",
        // 可按模型覆盖 maxTokens / firstChunkTimeoutMs / streamIdleTimeoutMs /
        // streamTotalTimeoutMs / streamRetries / streamRetryBaseDelayMs；
        // 未设置时用 provider 下的同名全局值
        // "maxTokens": 32768,
        "description": "默认模型"
      }
    ],
    "temperature": 0,
    // 不设置时不发送 max_tokens，交给后端自己的默认值（DeepSeek 思考模式默认 64K）
    // "maxTokens": 32768,
    // 本示例将 SDK 请求超时和单次尝试的总超时设为 20 分钟，容纳首包排队及后续输出。
    // 两者的加载器默认值仍是 120000；仅增加 firstChunkTimeoutMs 不足以延长等待。
    "requestTimeoutMs": 1200000,
    // 首个流式 chunk 前的等待上限（连接建立 + 服务端排队）；默认 10 分钟，
    // 对齐 DeepSeek 高负载时"10 分钟未开始推理即断连"的窗口
    "firstChunkTimeoutMs": 600000,
    "streamIdleTimeoutMs": 60000,
    // 从请求开始计时，包含首包等待；总超时或流中空闲超时不会重试。
    "streamTotalTimeoutMs": 1200000,
    "streamRetries": 2,
    "streamRetryBaseDelayMs": 500,
    "streamIncludeUsage": true,
    // 默认 "all"：把捕获的 reasoning_content 回传给后端（DeepSeek 思考模式要求）；
    // 端点不认识该字段且会报错时改 "none"
    // "passBackReasoning": "all",
    "extraHeaders": {}
  },
  "agent": {
    "maxIterations": 120,
    "historyWarningMessages": 400,
    "toolTimeoutMs": 300000,
    "permissionMode": "confirm",
    "systemPrompt": null
  },
  "mcp": {
    "enabled": true,
    "connectTimeoutMs": 15000
  },
  "skills": {
    "enabled": true,
    // [] 使用 <session cwd>/skills 和 ~/.config/sangxia/skills，同名时前者优先。
    // 非空列表替换默认目录；相对路径按 session cwd 解析，需全局技能时显式列入全局目录。
    "dirs": []
  },
  "hooks": {
    // 生命周期钩子（默认关闭）：在固定点位跑外部命令，stdin 收 JSON 信封、
    // stdout 出决策 JSON，`exit 2` 等价 deny。详见 README 的「Hook（生命周期钩子）」。
    // 注意：deny 与 ask 在 permissionMode=auto（Full Access）下同样生效。
    // 想要"在所有项目里都生效"的 hook，就把 hooks 写进 ~/.config/sangxia/config.json
    // （全局 base，见 README 的「配置分层」）；本文件的 hooks.events 是**追加**在它后面的。
    // 以下标量仅展示默认值，保持注释以继承全局设置；启用时显式设置 enabled: true。
    // 项目里显式 enabled: false 会关闭全局 hook；onError: allow 会覆盖全局 deny
    // （条目自己的 onError 优先）。事件数组追加不代表这些字段也保留全局值。
    // "enabled": false,
    // "timeoutMs": 60000,
    // 超时 / 崩溃 / 输出不可解析时："allow"（默认放行）| "deny"（fail-closed）
    // "onError": "allow",
    // null = 平台默认（shell: true）；也可指定 "/bin/bash"
    // "shell": null,
    // 项目级 hooks（.sangxia/hooks.json）：默认关闭 —— 该文件随仓库分发，
    // 开启等于“打开仓库就执行它声明的任意命令”（供应链风险）。
    // 开启后：相对路径以项目根为基准；onError / timeoutMs 只能更严不能放宽。
    "projectFile": {
      // "enabled": false,
      // "path": ".sangxia/hooks.json"
    },
    "events": {
      // 以下示例直接执行 ${HOME}/… 脚本：需先创建脚本，设置 shebang（如 #!/bin/bash）
      // 并赋予执行权限（chmod +x）。启用 hooks 后，加载器会校验路径形态的首个命令 token
      // 是否为已有文件；相对命令路径按声明它的配置文件目录解析，不是 session cwd。
      // bash /path/script.sh 属于内联命令，不校验脚本参数；/bin/bash 也只校验解释器本身。
      // hook 运行时 cwd 仍为 session cwd；配置级脚本应避免从仓库解析其可执行程序。
      "session_start": [
        // matcher 匹配 source：startup（session/new）| resume（session/load），与 codex 的
        // SessionStart 一致；没有可匹配字段的事件上写 matcher 会被忽略（并 warn 一次）。
        // { "name": "git-context", "command": "${HOME}/.config/sangxia/hooks/git-context.sh", "matcher": "startup|resume" },
        // 后台预热：在 warm-index.sh 中用绝对路径启动程序，并以 >/dev/null 2>&1 & 后台运行，
        // 避免后台进程持有 hook 的输出管道，脚本即可立刻返回。
        // { "name": "warm-index", "command": "${HOME}/.config/sangxia/hooks/warm-index.sh", "matcher": "startup|resume", "timeoutMs": 2000 }
      ],
      "user_prompt_submit": [
        // { "name": "secret-scan", "command": "${HOME}/.config/sangxia/hooks/secret-scan.sh", "timeoutMs": 5000, "onError": "deny" }
      ],
      "pre_tool_use": [
        // { "name": "guard-writes", "matcher": "^(write_file|edit_file)$", "command": "${HOME}/.config/sangxia/hooks/guard-writes.sh" },
        // { "name": "guard-bash", "matcher": "^bash$", "command": "${HOME}/.config/sangxia/hooks/guard-bash.sh", "onError": "deny" },
        // MCP 工具的注册名带前缀：{ "name": "guard-mcp", "matcher": "^mcp__router__execute_terminal_command$", "command": "${HOME}/.config/sangxia/hooks/guard-mcp.sh" }
      ],
      "post_tool_use": [
        // { "name": "ts-check", "matcher": "^edit_file$", "command": "${HOME}/.config/sangxia/hooks/ts-check.sh", "timeoutMs": 120000 }
      ],
      "turn_end": [
        // { "name": "audit", "command": "${HOME}/.config/sangxia/hooks/audit.sh" }
      ],
      "session_end": [
        // 当前仅在进程退出时尽力执行，整个退出 Hook 阶段最多等待 2 秒；不是 ACP 会话关闭事件。
        // { "name": "cleanup", "command": "${HOME}/.config/sangxia/hooks/cleanup.sh" }
      ]
    }
  }
}
